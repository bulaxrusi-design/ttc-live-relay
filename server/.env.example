PORT=8787
BIND_ADDRESS=127.0.0.1
DEVICE_ENROLLMENT_TOKEN=replace-with-at-least-32-random-characters
# Optional for public/manual MCP deployments. Secure MCP Tunnel can provide the
# outer authorization boundary instead.
MCP_BEARER_TOKEN=
# Required only for autonomous Computer Use. Never put this in the APK.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6
FRAME_WAIT_MS=5000
COMMAND_TIMEOUT_MS=30000
SOURCE_FRAME_MAX_AGE_MS=15000
# Persistent metadata only: TTC, actions, ACK/latency, device and autoplay events.
# Screen frames are never written by the research recorder.
RECORD_RESEARCH_DATA=true
DATA_DIR=./data
